{
    "name": "nhanaz/ecoapi",
    "description": "Simple and unified economy API library for PocketMine-MP plugins",
    "type": "library",
    "license": "Apache-2.0",
    "require": {
        "php": "^8.1",
        "pocketmine/pocketmine-mp": "^5.0.0"
    },
    "require-dev": {
        "axolotl-pm/pocketmine-mp": "5.49.1",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "NhanAZ\\EcoAPI\\": "src/NhanAZ/EcoAPI/"
        }
    },
    "config": {
        "allow-plugins": false,
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/axolotl-pm/PocketMine-MP",
            "no-api": true
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "phpstan": "@php vendor/bin/phpstan analyse --level=max --no-progress -c phpstan.neon.dist src example/src",
        "test": "@php tests/provider-money.php"
    },
    "extra": {
        "virion": {
            "spec": "3.0",
            "namespace-root": "NhanAZ\\EcoAPI"
        }
    }
}
